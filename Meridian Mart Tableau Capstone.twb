      <column caption='Sales Current Year' datatype='real' name='[Calculation_1224907056300056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))}&#13;&#10;    THEN [Sales] END)' />
      </column>

          </datasources>
          <datasource-dependencies datasource='federated.02epzzi03i2v8u1384p3n18ypl7j'>
            <column caption='Order Count' datatype='integer' name='[Calculation_1224907020525585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Order ID])' />
            </column>
            <column caption='MIN(0.16)' datatype='real' name='[Calculation_1224907064291357]' role='measure' type='quantitative' user:unnamed='KPI Total Sales'>
              <calculation class='tableau' formula='MIN(0.16)' />
            </column>
            <column caption='MIN(1)' datatype='integer' name='[Calculation_1224907064553503]' role='measure' type='quantitative' user:unnamed='KPI Total Sales'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='YoY Label' datatype='string' name='[Calculation_1224907067105312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;vs &quot; + STR({MAX(YEAR([Order Date]))} - 1)' />
            </column>
            <column caption='Orders Current Year' datatype='integer' name='[Calculation_1224907082313764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))} &#13;&#10;    THEN [Order ID] END)' />
            </column>
            <column caption='Orders Previous Year' datatype='integer' name='[Calculation_1224907083423781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))} - 1&#13;&#10;    THEN [Order ID] END)' />
            </column>
            <column caption='Orders YoY%' datatype='real' name='[Calculation_1224907083579430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1224907082313764] - [Calculation_1224907083423781])&#13;&#10;/&#13;&#10;[Calculation_1224907083423781]' />
